{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/chat", "destination": "/index.html" },
    { "source": "/doctor", "destination": "/index.html" },
    { "source": "/encyclopedia", "destination": "/index.html" },
    { "source": "/encyclopedia/:slug", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/clinical-review", "destination": "/index.html" },
    { "source": "/guidelines", "destination": "/index.html" }
  ]
}
